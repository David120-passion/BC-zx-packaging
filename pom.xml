<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.0</version>
  </parent>

  <groupId>com.hq</groupId>
  <artifactId>BC-zx-packaging</artifactId>
  <version>0.1.0</version>
  <name>BC-zx-packaging</name>

  <properties>
    <java.version>21</java.version>
    <javafx.version>21.0.2</javafx.version>
    <javafx.platform>win</javafx.platform>
    <vertx.version>4.5.10</vertx.version>
    <sqlite.version>3.46.0.0</sqlite.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>${sqlite.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
      <classifier>${javafx.platform}</classifier>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-swing</artifactId>
      <version>${javafx.version}</version>
      <classifier>${javafx.platform}</classifier>
    </dependency>
    <dependency>
      <groupId>com.fazecast</groupId>
      <artifactId>jSerialComm</artifactId>
      <version>2.11.0</version>
    </dependency>
    <dependency>
      <groupId>io.vertx</groupId>
      <artifactId>vertx-core</artifactId>
      <version>${vertx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>com.google.zxing</groupId>
      <artifactId>core</artifactId>
      <version>3.5.3</version>
    </dependency>
    <dependency>
      <groupId>com.google.zxing</groupId>
      <artifactId>javase</artifactId>
      <version>3.5.3</version>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes><exclude>version.properties</exclude></excludes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes><include>version.properties</include></includes>
      </resource>
      <resource>
        <directory>${project.build.directory}/laser-bridge</directory>
        <filtering>false</filtering>
        <targetPath>laser-bridge</targetPath>
        <includes><include>LaserBridge.exe</include></includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <release>21</release>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <mainClass>com.hq.iol.MainApp</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.hq.iol.MainApp</mainClass>
          <classifier>exec</classifier>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <mainClass>com.hq.iol.MainApp</mainClass>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <executions>
          <execution>
            <id>compile-laser-bridge</id>
            <phase>generate-resources</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <target>
                <mkdir dir="${project.build.directory}/laser-bridge"/>
                <exec executable="C:/Windows/Microsoft.NET/Framework/v4.0.30319/csc.exe" failonerror="true">
                  <arg value="/nologo"/>
                  <arg value="/utf8output"/>
                  <arg value="/optimize+"/>
                  <arg value="/platform:x86"/>
                  <arg value="/target:exe"/>
                  <arg value="/reference:System.Web.Extensions.dll"/>
                  <arg value="/out:${project.build.directory}/laser-bridge/LaserBridge.exe"/>
                  <arg path="${project.basedir}/src/native/laser-bridge/LaserBridge.cs"/>
                </exec>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>dist</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <executions>
              <execution>
                <id>copy-deps</id>
                <phase>package</phase>
                <goals><goal>copy-dependencies</goal></goals>
                <configuration>
                  <outputDirectory>${project.build.directory}/jpackage-input</outputDirectory>
                  <includeScope>runtime</includeScope>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <executions>
              <execution>
                <id>clean-jpackage-input</id>
                <phase>prepare-package</phase>
                <goals><goal>run</goal></goals>
                <configuration>
                  <target>
                    <delete dir="${project.build.directory}/jpackage-input" quiet="true"/>
                    <delete dir="${project.build.directory}/dist" quiet="true"/>
                    <mkdir dir="${project.build.directory}/laser-runtime/laser-sdk"/>
                    <copy todir="${project.build.directory}/laser-runtime/laser-sdk">
                      <fileset dir="${project.basedir}/src/main/laser-sdk">
                        <exclude name="log.txt"/>
                        <exclude name="cfglog.txt"/>
                      </fileset>
                    </copy>
                    <copy todir="${project.build.directory}/laser-runtime/laser-driver">
                      <fileset dir="${project.basedir}/src/main/laser-driver"/>
                    </copy>
                  </target>
                </configuration>
              </execution>
              <execution>
                <id>strip-sqlite-natives</id>
                <phase>package</phase>
                <goals><goal>run</goal></goals>
                <configuration>
                  <target>
                    <unzip src="${project.build.directory}/jpackage-input/sqlite-jdbc-${sqlite.version}.jar"
                           dest="${project.build.directory}/sqlite-strip"/>
                    <delete includeemptydirs="true">
                      <fileset dir="${project.build.directory}/sqlite-strip/org/sqlite/native">
                        <exclude name="Windows/**"/>
                      </fileset>
                    </delete>
                    <delete file="${project.build.directory}/jpackage-input/sqlite-jdbc-${sqlite.version}.jar" quiet="true"/>
                    <zip basedir="${project.build.directory}/sqlite-strip"
                         destfile="${project.build.directory}/jpackage-input/sqlite-jdbc-${sqlite.version}.jar"/>
                    <delete dir="${project.build.directory}/sqlite-strip" quiet="true"/>
                  </target>
                </configuration>
              </execution>
              <execution>
                <id>jpackage</id>
                <phase>package</phase>
                <goals><goal>run</goal></goals>
                <configuration>
                  <target>
                    <delete quiet="true">
                      <fileset dir="${project.build.directory}/jpackage-input">
                        <include name="javafx-*.jar"/>
                        <exclude name="javafx-*-win.jar"/>
                      </fileset>
                    </delete>
                    <copy file="${project.build.directory}/${project.artifactId}-${project.version}.jar"
                          todir="${project.build.directory}/jpackage-input"/>
                    <exec executable="${java.home}/bin/jpackage.exe" failonerror="true">
                      <arg value="--type"/>
                      <arg value="app-image"/>
                      <arg value="--input"/>
                      <arg value="${project.build.directory}/jpackage-input"/>
                      <arg value="--dest"/>
                      <arg value="${project.build.directory}/dist"/>
                      <arg value="--name"/>
                      <arg value="IOLPackaging-v${project.version}"/>
                      <arg value="--vendor"/>
                      <arg value="IOL"/>
                      <arg value="--copyright"/>
                      <arg value="Copyright (C) 2026 IOL"/>
                      <arg value="--main-jar"/>
                      <arg value="${project.artifactId}-${project.version}.jar"/>
                      <arg value="--main-class"/>
                      <arg value="com.hq.iol.MainApp"/>
                      <arg value="--add-modules"/>
                      <arg value="java.base,java.compiler,java.desktop,java.instrument,java.logging,java.management,java.naming,java.net.http,java.prefs,java.rmi,java.scripting,java.security.jgss,java.sql,java.sql.rowset,java.xml,jdk.attach,jdk.crypto.ec,jdk.jdi,jdk.jfr,jdk.localedata,jdk.unsupported,jdk.unsupported.desktop"/>
                      <arg value="--jlink-options"/>
                      <arg value="--strip-debug --no-man-pages --no-header-files --strip-native-commands"/>
                      <arg value="--java-options"/>
                      <arg value="-p $APPDIR --add-modules javafx.controls,javafx.swing"/>
                      <arg value="--app-version"/>
                      <arg value="${project.version}"/>
                      <arg value="--icon"/>
                      <arg value="${project.basedir}/src/main/resources/icon.ico"/>
                      <arg value="--app-content"/>
                      <arg value="${project.build.directory}/laser-runtime/laser-sdk"/>
                      <arg value="--app-content"/>
                      <arg value="${project.build.directory}/laser-runtime/laser-driver"/>
                    </exec>
                  </target>
                </configuration>
              </execution>
              <execution>
                <id>zip-dist</id>
                <phase>package</phase>
                <goals><goal>run</goal></goals>
                <configuration>
                  <target>
                    <zip basedir="${project.build.directory}/dist"
                         includes="IOLPackaging-v${project.version}/**"
                         destfile="${project.build.directory}/dist/IOLPackaging-${project.version}.zip"/>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
